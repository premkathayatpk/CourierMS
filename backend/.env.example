PORT=8000
# Local MongoDB (view it in MongoDB Compass at mongodb://127.0.0.1:27017)
MONGO_URL=mongodb://127.0.0.1:27017/CourierMS
# Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173
# Set to "production" when serving over HTTPS (secure, cross-site auth cookie)
NODE_ENV=development
# Optional: where uploaded images are stored (default: backend/uploads)
# UPLOAD_DIR=./uploads
